{
  "_comment": [
    "The retired Java worker's platform jobs (worker V3, V9, V10, V11, V13 as left by V14) as the platform app's",
    "EventDefinitions, EventActions and job functions, less entity-processor's: that service retired with the switch",
    "to Rust (2026-10-18), so ENTITY_PROCESSOR_METERING is gone and BILLING_RECONCILE names the three services it",
    "reconciles (security, core, files). Read by tools/seed_platform_app.py (which creates them on LOCAL through the",
    "APIs), tools/make_platform_transport.py (which exports them from LOCAL into a core transport file) and",
    "crates/core/src/functions/platform_tests.rs (which runs every job function against fakes).",
    "Each job: a schedule on its EventDefinition (the worker's Quartz cron as five Unix fields, UTC, one run for",
    "SYSTEM), an EventAction with one CALL_CORE_FUNCTION task calling Platform.Jobs.<job>, and that stored function,",
    "which calls CoreServices.Platform.<function> with the job's literal arguments (the worker's job data; the task",
    "passes no arguments: a scheduled tick's event data carries only its _schedule marker)."
  ],
  "app": {
    "appCode": "platform",
    "clientCode": "SYSTEM",
    "appName": "Platform",
    "appType": "APP",
    "appAccessType": "OWN"
  },
  "jobs": [
    {
      "name": "SSL_RENEWAL",
      "workerTask": "ssl-certificate-renewal",
      "workerJobType": "SSL_RENEWAL",
      "workerSchedule": "0 0 2 * * ?",
      "workerJobData": {
        "daysBeforeExpiry": 3
      },
      "description": "Renew expiring SSL certificates",
      "cron": "0 2 * * *",
      "function": "CoreServices.Platform.RenewCertificates",
      "arguments": {
        "daysBeforeExpiry": 3
      }
    },
    {
      "name": "TOKEN_CLEANUP",
      "workerTask": "expired-token-cleanup",
      "workerJobType": "TOKEN_CLEANUP",
      "workerSchedule": "0 0 3 * * ?",
      "workerJobData": {
        "unusedDays": 90
      },
      "description": "Delete expired and unused security and core tokens",
      "cron": "0 3 * * *",
      "function": "CoreServices.Platform.CleanupTokens",
      "arguments": {
        "unusedDays": 90
      }
    },
    {
      "name": "SECURITY_METERING",
      "workerTask": "security-metering",
      "workerJobType": "SECURITY_METERING",
      "workerSchedule": "0 0/15 * * * ?",
      "workerJobData": {},
      "description": "Charge security-owned token rent (app/site/user) for the current 15-minute window",
      "cron": "*/15 * * * *",
      "function": "CoreServices.Platform.Meter",
      "arguments": {
        "service": "security"
      }
    },
    {
      "name": "CORE_METERING",
      "workerTask": "core-metering",
      "workerJobType": "CORE_METERING",
      "workerSchedule": "0 0/15 * * * ?",
      "workerJobData": {},
      "description": "Charge core storage-row token rent for the current 15-minute window",
      "cron": "*/15 * * * *",
      "function": "CoreServices.Platform.Meter",
      "arguments": {
        "service": "core"
      }
    },
    {
      "name": "FILES_METERING",
      "workerTask": "files-metering",
      "workerJobType": "FILES_METERING",
      "workerSchedule": "0 0/15 * * * ?",
      "workerJobData": {},
      "description": "Charge files (static+secured GB) token rent for the current 15-minute window",
      "cron": "*/15 * * * *",
      "function": "CoreServices.Platform.Meter",
      "arguments": {
        "service": "files"
      }
    },
    {
      "name": "BILLING_RECONCILE",
      "workerTask": "billing-reconcile",
      "workerJobType": "BILLING_RECONCILE",
      "workerSchedule": "0 45 0 * * ?",
      "workerJobData": {},
      "description": "Back-charge any 15-minute window of the previous day missed to downtime",
      "cron": "45 0 * * *",
      "function": "CoreServices.Platform.ReconcileBilling",
      "arguments": {
        "services": [
          "security",
          "core",
          "files"
        ]
      }
    },
    {
      "name": "FILES_TTL_CLEANUP",
      "workerTask": "files-ttl-cleanup",
      "workerJobType": "FILES_TTL_CLEANUP",
      "workerSchedule": "0 20 * * * ?",
      "workerJobData": {
        "limit": 500
      },
      "description": "Delete files whose per-file lifetime has expired (secured + static)",
      "cron": "20 * * * *",
      "function": "CoreServices.Platform.CleanupExpiredFiles",
      "arguments": {
        "limit": 500
      }
    },
    {
      "name": "TRANSPORT_CLEANUP_UI",
      "workerTask": "transport-cleanup-ui",
      "workerJobType": "TRANSPORT_CLEANUP",
      "workerSchedule": "0 40 3 * * ?",
      "workerJobData": {
        "service": "ui",
        "retentionDays": 90,
        "limit": 200
      },
      "description": "Delete ui app-transport import receipts and their versions older than the retention window",
      "cron": "40 3 * * *",
      "function": "CoreServices.Platform.CleanupTransports",
      "arguments": {
        "service": "ui",
